<section class="k8-actor-sheet">
  {{#if backgroundArt}}
    <div
      class="k8-fixed-art"
      style="background-image: url('{{backgroundArt}}');"
    ></div>
  {{/if}}

  <div class="k8-scroll-content">
    <header class="k8-sheet-header">
      <div class="k8-portrait-frame {{#if isArtMode}}is-art-mode{{else}}is-portrait-mode{{/if}}">
        <img
          class="k8-portrait-image"
          src="{{displayImage}}"
          title="{{#if isArtMode}}Click to change character artwork{{else}}Click to change token artwork{{/if}}"
        />

        {{#if showImageLabel}}
          <div class="k8-portrait-label">
            {{#if isArtMode}}ART{{else}}PORTRAIT{{/if}}
          </div>
        {{/if}}

        <button type="button" class="k8-portrait-toggle" title="Switch portrait / art">
          ⇄
        </button>
      </div>

      <input class="k8-actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Name" />

      <div class="k8-gender-select">
        <label>Gender</label>
        <select name="system.identity.gender">
          {{selectOptions genderOptions selected=system.identity.gender}}
        </select>
      </div>
    </header>

    <nav class="k8-sheet-tabs">
      <button type="button" class="k8-tab-button {{#if isMainTab}}active{{/if}}" data-tab="main">
        Main
      </button>

      <button type="button" class="k8-tab-button {{#if isInventoryTab}}active{{/if}}" data-tab="inventory">
        Inventory
      </button>

      <button type="button" class="k8-tab-button {{#if isModifiersTab}}active{{/if}}" data-tab="modifiers">
        Modifiers
      </button>
    </nav>

    {{#if isMainTab}}
      {{> "systems/k8system/templates/actor/tabs/main.hbs"}}
    {{/if}}

    {{#if isInventoryTab}}
      {{> "systems/k8system/templates/actor/tabs/inventory.hbs"}}
    {{/if}}

    {{#if isModifiersTab}}
      {{> "systems/k8system/templates/actor/tabs/modifiers.hbs"}}
    {{/if}}
  </div>
</section>